// Esquema de datos de SignaJob.
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
}

// Empresa cliente del SaaS. Es la raíz del aislamiento multi-tenant:
// toda consulta de negocio debe filtrar por companyId.
model Company {
  id        String   @id @default(cuid())
  name      String
  cif       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("companies")
}

// Usuario de una empresa.
// El email es único GLOBAL, no por empresa: el login se hace con email y
// contraseña sin pedir la empresa, así que dos empresas no pueden compartirlo.
model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String   @unique
  name         String
  role         Role     @default(TECHNICIAN)
  active       Boolean  @default(true)
  // Hash en formato versionado (`scrypt$N$r$p$sal$hash`). Nunca la contraseña.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([companyId])
  @@map("users")
}

// Sesión de un usuario. Se guarda el HASH del token, no el token:
// una filtración de la base de datos no permite suplantar sesiones.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
