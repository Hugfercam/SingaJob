// Esquema de datos de SignaJob.
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
}

// Empresa cliente del SaaS. Es la raíz del aislamiento multi-tenant:
// toda consulta de negocio debe filtrar por companyId.
model Company {
  id        String   @id @default(cuid())
  name      String
  cif       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
  clients     Client[]
  projects    Project[]
  templates   Template[]
  workOrders  WorkOrder[]
  attachments Attachment[]

  @@map("companies")
}

// Usuario de una empresa.
// El email es único GLOBAL, no por empresa: el login se hace con email y
// contraseña sin pedir la empresa, así que dos empresas no pueden compartirlo.
model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String   @unique
  name         String
  role         Role     @default(TECHNICIAN)
  active       Boolean  @default(true)
  // Hash en formato versionado (`scrypt$N$r$p$sal$hash`). Nunca la contraseña.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions Session[]

  assignedWorkOrders WorkOrder[] @relation("AssignedWorkOrders")
  createdWorkOrders  WorkOrder[] @relation("CreatedWorkOrders")

  @@index([companyId])
  @@map("users")
}

// Sesión de un usuario. Se guarda el HASH del token, no el token:
// una filtración de la base de datos no permite suplantar sesiones.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Invitación de un empleado a una empresa.
// Del token solo se guarda el hash, igual que en las sesiones. La invitación
// caduca, se usa una sola vez y el administrador puede revocarla.
model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        Role      @default(TECHNICIAN)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, email])
  @@map("invitations")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  FINISHED
}

// Cliente de la empresa (el que firma el albarán).
model Client {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  workOrders WorkOrder[]

  @@index([companyId, name])
  @@map("clients")
}

// Obra o proyecto de un cliente.
// `companyId` está duplicado a propósito para poder filtrar por empresa sin
// depender del join con el cliente; al crear se valida que coincida.
model Project {
  id        String        @id @default(cuid())
  companyId String
  clientId  String
  name      String
  address   String?
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  workOrders WorkOrder[]

  @@index([companyId])
  @@index([clientId])
  @@map("projects")
}

// Plantilla de parte: define qué campos se rellenan en un tipo de trabajo.
// La definición vive en `fields` (JSON validado en código, ver D-008).
model Template {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  fields      Json     @default("[]")
  archived    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@index([companyId, name])
  @@map("templates")
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Parte de trabajo.
// `fieldsSnapshot` es una copia de la definición de la plantilla en el momento
// de crear el parte: editar la plantilla después no altera partes ya hechos.
model WorkOrder {
  id             String          @id @default(cuid())
  companyId      String
  clientId       String
  projectId      String?
  templateId     String?
  title          String
  status         WorkOrderStatus @default(PENDING)
  fieldsSnapshot Json            @default("[]")
  values         Json            @default("{}")
  assignedToId   String?
  createdById    String?
  startedAt      DateTime?
  completedAt    DateTime?
  startLatitude  Float?
  startLongitude Float?
  endLatitude    Float?
  endLongitude   Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("AssignedWorkOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("CreatedWorkOrders", fields: [createdById], references: [id], onDelete: SetNull)

  attachments Attachment[]

  @@index([companyId, status])
  @@index([assignedToId])
  @@index([clientId])
  @@map("work_orders")
}

enum AttachmentKind {
  PHOTO
  SIGNATURE_CLIENT
  SIGNATURE_TECHNICIAN
}

// Foto o firma de un parte. El archivo vive en el almacenamiento (disco local
// por ahora, R2 después) y aquí solo se guarda su referencia.
model Attachment {
  id          String         @id @default(cuid())
  companyId   String
  workOrderId String
  kind        AttachmentKind
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String         @unique
  createdById String?
  createdAt   DateTime       @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, kind])
  @@map("attachments")
}
