// Esquema de datos de SignaJob.
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
}

// Empresa cliente del SaaS. Es la raíz del aislamiento multi-tenant:
// toda consulta de negocio debe filtrar por companyId.
model Company {
  id        String   @id @default(cuid())
  name      String
  cif       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
  clients     Client[]
  projects    Project[]

  @@map("companies")
}

// Usuario de una empresa.
// El email es único GLOBAL, no por empresa: el login se hace con email y
// contraseña sin pedir la empresa, así que dos empresas no pueden compartirlo.
model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String   @unique
  name         String
  role         Role     @default(TECHNICIAN)
  active       Boolean  @default(true)
  // Hash en formato versionado (`scrypt$N$r$p$sal$hash`). Nunca la contraseña.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([companyId])
  @@map("users")
}

// Sesión de un usuario. Se guarda el HASH del token, no el token:
// una filtración de la base de datos no permite suplantar sesiones.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Invitación de un empleado a una empresa.
// Del token solo se guarda el hash, igual que en las sesiones. La invitación
// caduca, se usa una sola vez y el administrador puede revocarla.
model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        Role      @default(TECHNICIAN)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, email])
  @@map("invitations")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  FINISHED
}

// Cliente de la empresa (el que firma el albarán).
model Client {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([companyId, name])
  @@map("clients")
}

// Obra o proyecto de un cliente.
// `companyId` está duplicado a propósito para poder filtrar por empresa sin
// depender del join con el cliente; al crear se valida que coincida.
model Project {
  id        String        @id @default(cuid())
  companyId String
  clientId  String
  name      String
  address   String?
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clientId])
  @@map("projects")
}
