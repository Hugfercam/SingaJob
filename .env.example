# Plantilla de variables de entorno. Copiar a `.env` y rellenar.
# Nunca subir el `.env` real al repositorio ni pegar credenciales en la documentación.

# Cadena de conexión de PostgreSQL.
# Ejemplo para desarrollo local:
#   postgresql://USUARIO:CONTRASEÑA@localhost:5432/signajob_dev?schema=public
DATABASE_URL="postgresql://signajob:signajob@localhost:5432/signajob_dev?schema=public"
